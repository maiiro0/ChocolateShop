{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<main>
    {% embed 'component/_card.html.twig' %}
        {% block card_content %}
            <section class="flex p-3 gap-8 justify-between">
                <div>
                    <p class="text-[#B57842] font-bold py-4">CHOCOLATERIE ARTISANALE · DEPUIS 1998</p>
                    <p class="font-bold text-5xl pb-4">Le goût du cacao, l’art de l’exception.</p>
                    <p class="font-black text-2xl pb-10">Des créations délicates façonnées à la main, pour transformer chaque instant en plaisir.</p>
                    <button class="bg-[#B57842] rounded-full font-bold text-white py-2 px-4 hover:bg-[#8B4513]">Découvrir nos chocolats</button>
                </div>
                <div>
                    <img src="{{ asset('images/Main.svg') }}" alt="Chocolat Artisanal" class="rounded-xl shadow-md w-250">
                </div>
            </section>
        {% endblock %}
    {% endembed %}
    <section class="flex justify-between gap-8 py-8">
        <div>
            <h2 class="text-5xl font-bold mb-4 text-[#351C17] pt-4">Une passion qui se partage</h2>
            <p class="text-[#351C17] font-black text-2xl">Chez Maison Cacao, nous sélectionnons des fèves d’exception 
                et les travaillons avec patience. Chaque création raconte 
                une origine, un geste et une émotion.</p>
        </div>
        <div>
            <img src="{{ asset('images/PartagePassion.svg') }}" alt="Passion Chocolat" class="rounded-xl shadow-md w-250">
        </div>
    </section>

    <section aria-labelledby="best-sellers-title" class="py-12">
        <h2 id="best-sellers-title" class="mb-6 text-3xl font-bold text-[#351C17]">Nos chocolats à découvrir</h2>
        {% if bestSellers %}
            {% include 'product/_carousel.html.twig' with {products: bestSellers, label: 'Produits à découvrir'} only %}
        {% else %}
            <p>Aucun produit à afficher.</p>
        {% endif %}
    </section>


    <h2 id="testimonials-title" class="mb-6 pt-4 text-3xl font-bold text-[#351C17]">Ils en parlent mieux que nous</h2>
    <section aria-labelledby="testimonials-title" class="grid grid-cols-3 gap-8 py-4 pb-20">
        <figure class="h-full min-w-0 rounded-xl bg-white p-4">
            <p class="font-bold text-[#351C17] text-xl">Des chocolats délicieux et une belle découverte à chaque commande.</p>
            <p class="font-bold text-[#351C17] text-lg pb-4">Camille - cliente</p>
        </figure>
        <figure class="h-full min-w-0 rounded-xl bg-white p-4">
            <p class="font-bold text-[#351C17] text-xl">Une sélection soignée, parfaite pour offrir.</p>
            <p class="font-bold text-[#351C17] text-lg pb-4">Alexandre - client</p>
        </figure>
        <figure class="h-full min-w-0 rounded-xl bg-white p-4">
            <p class="font-bold text-[#351C17] text-xl">Je commande régulièrement chez vous, toujours satisfait.</p>
            <p class="font-bold text-[#351C17] text-lg pb-4">Marie - cliente</p>
        </figure>
    </section>
</main>
{% endblock %}
