{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<main>
    <h1>Accueil</h1>
    <section aria-label="À la une">
        {% for slide in slides %}
            <article>
                {% if slide.getMessage() %}
                    <p>{{ slide.getMessage() }}</p>
                {% endif %}
                <h2>{{ slide.getTitle() }}</h2>
                <p>{{ slide.getContent() }}</p>
                <a href="{{ slide.getButtonLink() }}">{{ slide.getButtonText() }}</a>
            </article>
        {% else %}
            <p>Aucune diapositive à afficher.</p>
        {% endfor %}
    </section>

    <section aria-labelledby="about-title">
        <h2 id="about-title">À propos</h2>
        <p>Nous sélectionnons avec soin des chocolats de qualité pour partager le plaisir du cacao.</p>
    </section>

    <section aria-labelledby="best-sellers-title">
        <h2 id="best-sellers-title">Nos tendances</h2>
        {% for product in bestSellers %}
            {% include 'product/_card.html.twig' with {product: product} only %}
        {% else %}
            <p>Aucun produit tendance pour le moment.</p>
        {% endfor %}
    </section>

    <section aria-labelledby="testimonials-title">
        <h2 id="testimonials-title">Témoignages</h2>
        <figure>
            <blockquote>Des chocolats délicieux et une belle découverte à chaque commande.</blockquote>
            <figcaption>Camille, cliente</figcaption>
        </figure>
        <figure>
            <blockquote>Une sélection soignée, parfaite pour offrir.</blockquote>
            <figcaption>Alexandre, client</figcaption>
        </figure>
    </section>
</main>
{% endblock %}
