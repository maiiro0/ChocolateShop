{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}

    {% embed 'component/_card.html.twig' %}
        {% block card_content %}
            <section class="flex p-3 justify-between">
                <div>
                    <p class="text-[#B57842] font-bold py-4">CHOCOLATERIE ARTISANALE · DEPUIS 1998</p>
                    <p class="font-bold text-5xl pb-4">Nous contacter</p>
                    <p class="text-xl pb-10">Une question sur un chocolat ou un coffret ? Écrivez à notre équipe.</p>
                </div>
                <div class="flex pr-8">
                    <img src="{{ asset('images/Cabosse.svg') }}" alt="Chocolat Artisanal" >
                    <img src="{{ asset('images/Cabosse-2.svg') }}" alt="Chocolat Artisanal" class="max-w-30" >
                </div>
            </section>
        {% endblock %}
    {% endembed %}

    <section  class="flex justify-between gap-10 py-8">
       <section class="flex flex-col bg-[#EDE0CE] rounded-2xl p-8 w-sm gap-y-10">
            <div>
                <p class="text-[#351C16] font-bold text-3xl">La chocolaterie</p>
            </div>
            <div class="border-1 border-[#CBB89D]"></div>
            <div>
                <p class="text-[#71584C] font-bold text-sm">Adresse</p>
                <p class="text-[#351C16] font-bold">12 rue du Cacao, Paris</p>
            </div>

            <div>
                <p class="text-[#71584C] font-bold text-sm">E-mail</p>
                <p class="text-[#351C16] font-bold">contact@chocoshop.fr</p>
            </div>

            <div>
                <p class="text-[#71584C] font-bold text-sm">Téléphone</p>
                <p class="text-[#351C16] font-bold">01 23 45 67 89</p>
            </div>
            <div class="justify-items-end">
                <img src="{{ asset('images/Cabosse-3.svg') }}" alt="Chocolaterie">
            </div>
        </section> 

            
        <form method="post" action="" class="flex flex-col gap-y-10 w-5/7 py-2">
            <p class="text-[#351C16] font-bold text-3xl">Votre message</p>
            <div class="flex flex-row gap-x-10">
                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="lastName" class="text-[#351C16] font-bold">Nom</label>
                    <input type="text" id="lastName" name="lastName" class="bg-[#FFFCF7] rounded-md border-2 p-2 border-[#D7C8B6]">
                </div>

                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="firstName" class="text-[#351C16] font-bold">Prénom</label>
                    <input type="text" id="firstName" name="firstName" class="bg-[#FFFCF7] rounded-md border-2 p-2 border-[#D7C8B6]">
                </div>
            </div>
            <div class="flex flex-row gap-x-10">
                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="email" class="text-[#351C16] font-bold">E-mail</label>
                    <input type="email" id="email" name="email" class="bg-[#FFFCF7] rounded-md border-2 p-2 border-[#D7C8B6]">
                </div>

                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="phone" class="text-[#351C16] font-bold">Téléphone</label>
                    <input type="tel" id="phone" name="phone" class="bg-[#FFFCF7] rounded-md border-2 p-2 border-[#D7C8B6]">
                </div>
            </div>

            <div class="flex flex-col gap-y-2 w-full">
                <label for="message" class="text-[#351C16] font-bold">Message</label>
                <textarea id="message" name="message" rows="5" class="bg-[#FFFCF7] rounded-md border-2 p-2 border-[#D7C8B6]"></textarea>
            </div>
            <div class="flex">
                <button type="submit" class="bg-[#351C16] text-[#FFFCF7] font-bold p-3 rounded-full">Envoyer le message</button>
            </div>
        </form>
    </section>
{% endblock %}
