{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}

    {% include 'component/_card.html.twig' with {
        title: 'Nous contacter',
        description: 'Une question sur un chocolat ou un coffret ? Écrivez à notre équipe.'
    } only %}

    <section  class="flex justify-between gap-10 py-8">
       <section class="flex flex-col bg-[#EDE0CE] rounded-2xl p-8 w-sm gap-y-10">
            <div>
                <p class="text-[#351C16] font-bold text-3xl">La chocolaterie</p>
            </div>
            <div class="border-1 border-[#CBB89D]"></div>
            <div>
                <p class="text-[#71584C] font-bold text-sm">Adresse</p>
                <p class="text-[#351C16] font-bold">12 rue du Cacao, Paris</p>
            </div>

            <div>
                <p class="text-[#71584C] font-bold text-sm">E-mail</p>
                <p class="text-[#351C16] font-bold">contact@chocoshop.fr</p>
            </div>

            <div>
                <p class="text-[#71584C] font-bold text-sm">Téléphone</p>
                <p class="text-[#351C16] font-bold">01 23 45 67 89</p>
            </div>
            <div class="justify-items-end">
                <img src="{{ asset('images/Cabosse-3.svg') }}" alt="Chocolaterie">
            </div>
        </section> 

            
        <form method="post" action="" class="flex flex-col gap-y-10 w-5/7 py-2">
            <p class="text-[#351C16] font-bold text-3xl">Votre message</p>
            <div class="flex flex-row gap-x-10">
                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="lastName" class="form-label">Nom</label>
                    <input type="text" id="lastName" name="lastName" class="form-field">
                </div>

                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="firstName" class="form-label">Prénom</label>
                    <input type="text" id="firstName" name="firstName" class="form-field">
                </div>
            </div>
            <div class="flex flex-row gap-x-10">
                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" id="email" name="email" class="form-field">
                </div>

                <div class="flex flex-col gap-y-2 w-1/2">
                    <label for="phone" class="form-label">Téléphone</label>
                    <input type="tel" id="phone" name="phone" class="form-field">
                </div>
            </div>

            <div class="flex flex-col gap-y-2 w-full">
                <label for="message" class="form-label">Message</label>
                <textarea id="message" name="message" rows="5" class="form-field"></textarea>
            </div>
            <div class="flex">
                <button type="submit" class="bg-[#351C16] text-[#FFFCF7] font-bold p-3 rounded-full">Envoyer le message</button>
            </div>
        </form>
    </section>
{% endblock %}
