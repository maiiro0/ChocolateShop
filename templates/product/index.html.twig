{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
    <main>
        {% include 'component/_card.html.twig' with {
            title: 'Catalogue',
            description: 'Découvrez nos chocolats par marque, catégorie ou prix.'
        } only %}
        <form
            id="product-filters"
            method="get"
            action="{{ path('app_products') }}"
            class="my-4 flex flex-wrap items-end gap-4"
        >

            <div class="flex flex-col gap-y-2">
                <label for="price" class="form-label">Prix maximum (€)</label>
                <input
                    type="number"
                    id="price"
                    name="price"
                    min="0"
                    step="0.01"
                    value="{{ prixMax }}"
                    class="form-field"
                >
            </div>

            <div class="flex flex-col gap-y-2">
                <label for="category" class="form-label">Catégorie</label>
                <select id="category" name="category" class="form-field">
                    <option value="">Toutes les catégories</option>
                    {% for choix in categories %}
                        <option value="{{ choix }}" {% if choix == categorie %}selected{% endif %}>
                            {{ choix }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex flex-col gap-y-2">
                <label for="brand" class="form-label">Marque</label>
                <select id="brand" name="brand" class="form-field">
                    <option value="">Toutes les marques</option>
                    {% for choix in brands %}
                        <option value="{{ choix }}" {% if choix == marque %}selected{% endif %}>
                            {{ choix }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <button type="submit" class="pill">
                Filtrer
            </button>

            <a href="{{ path('app_products') }}" class="pill">Tout afficher</a>
        </form>
        <section id="product-list" aria-label="Produits" class="py-12">
            {% if products %}
                {% include 'product/_carousel.html.twig' with {products: products, label: 'Produits du catalogue'} only %}
            {% else %}
                <p>Aucun produit ne correspond à ta recherche.</p>
            {% endif %}
        </section>
    </main>
{% endblock %}  
